import { ComboBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, SliderCfg } from "theme.slint";
import { Icon, Card, SectionTitle, SliderRow, Pill, Btn, ConfirmBtn, SoSwitch, ToggleRow, Tab, HotkeyField, SoSlider, MiniRow, MiniPill, IconBtn, ConfirmIconBtn, DayChip, DragZone, Reorder, Chip, Accordion } from "components.slint";

export { Theme, SliderCfg }

export struct MonitorItem { name: string, detail: string, internal: bool }
export struct ChoiceItem { label: string, value: int, dim: bool }
export struct ChipItem { icon: int, text: string }
export struct ProfileItem { name: string, active: bool, rows: [[ChipItem]] }
export struct MiniProfileItem { name: string, active: bool }
export struct ScheduleItem { time: string, profile: string, enabled: bool, days: [bool], end: string }
export struct HotkeyItem { id: string, label: string, combo: string }
export struct InfoItem { label: string, value: string }
export struct VcpRowItem { code: string, name: string, current: string, max: string, values: string }

