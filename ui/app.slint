    out property <string> color-red: @tr("Red");
    out property <string> color-green: @tr("Green");
    out property <string> color-blue: @tr("Blue");
    out property <string> mini-temp: @tr("Temperature");
    out property <string> color-filter-chip: @tr("Color filter");
    out property <string> info-hfreq: @tr("Horizontal frequency");
    out property <string> info-vfreq: @tr("Vertical frequency (refresh rate)");
