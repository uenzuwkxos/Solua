msgstr "周日"

msgid "About"
msgstr "关于"

msgid "Privacy policy"
msgstr "隐私政策"

msgid "Solua does not collect, store or send any personal data. It has no accounts, no analytics and makes no network connections. Your settings stay in a local file on this computer, and the only communication is between the app and your monitors through the standard DDC/CI protocol."
msgstr "Solua 不会收集、存储或发送任何个人数据。它没有账户、没有数据分析，也不建立任何网络连接。您的设置保存在这台电脑上的本地文件中，唯一的通信发生在应用与您的显示器之间，通过标准的 DDC/CI 协议进行。"

msgid "Open source licenses"
msgstr "开源许可证"

msgid "Close"
msgstr "关闭"

msgid "All monitors"
msgstr "所有显示器"

msgid "No profiles yet."
msgstr "还没有配置文件。"

msgid "A saved profile is active. Switch to “Free” to adjust settings."
msgstr "已启用保存的配置文件。请切换到“自由”以调整设置。"

msgid "Allow modifying saved profiles"
msgstr "允许修改已保存的配置文件"

msgid "BACKUP"
msgstr "备份"

msgid "Backup saved"
msgstr "备份已保存"

