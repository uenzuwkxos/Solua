msgid "SLIDERS AND SHORTCUTS"
msgstr "SLIDER DAN PINTASAN"

msgid "Save all your settings, profiles, schedule and shortcuts to a file, or load them from one."
msgstr "Simpan semua pengaturan, profil, jadwal, dan pintasan ke file, atau muat dari file."

msgid "Sliders move in fixed steps, marked with dots. Applies to the window and the mini panel."
msgstr "Slider bergerak dalam langkah tetap, ditandai dengan titik. Berlaku untuk jendela dan panel mini."

msgid "Step (sliders and shortcuts)"
msgstr "Langkah (slider dan pintasan)"

msgid "Stepped sliders"
msgstr "Slider bertahap"

msgid "Top"
msgstr "Atas"

msgid "Top left"
msgstr "Kiri atas"

msgid "Top right"
msgstr "Kanan atas"

msgid "Up"
msgstr "Ke atas"

msgid "While a profile is active, every change you make is saved into it automatically."
msgstr "Selama profil aktif, setiap perubahan yang Anda buat disimpan otomatis ke dalamnya."

msgid "Yellow"
msgstr "Kuning"

msgid "Yellowscale"
msgstr "Skala kuning"

msgid "Temperature down"
msgstr "Turunkan suhu"

msgid "Temperature up"
msgstr "Naikkan suhu"

