msgid "Enable DDC/CI in the monitor's on-screen menu, use a direct cable (avoid docks and adapters) and try again."
msgstr "Aktifkan DDC/CI di menu layar monitor, gunakan kabel langsung (hindari dock dan adaptor), lalu coba lagi."

msgid "Search again"
msgstr "Cari lagi"

