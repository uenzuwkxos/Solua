msgstr "Размер экрана"

msgid "Sets the level of the darkest areas of each color channel. It mostly affects the shadows, not the whites."
msgstr "Задаёт уровень самых тёмных областей каждого цветового канала. В основном влияет на тени, а не на белый цвет."

msgid "Show in the mini panel"
msgstr "Показывать в мини-панели"

msgid "This is the audio of the monitor itself (its speakers or headphone jack), for monitors that have it. It is not the system volume."
msgstr "Это звук самого монитора (его динамики или разъём для наушников) для мониторов, которые им оснащены. Это не системная громкость."

msgid "VCP version"
msgstr "Версия VCP"

msgid "Vertical frequency (refresh rate)"
msgstr "Вертикальная частота (частота обновления)"

msgid "Glass effect (blur) on the indicator and mini panel"
msgstr "Эффект стекла (размытие) для индикатора и мини-панели"

msgid "Color filter"
msgstr "Цветной фильтр"

msgid "Software filter applied to the whole system."
msgstr "Программный фильтр для всей системы."

msgid "Monitor volume up"
msgstr "Увеличить громкость монитора"

msgid "Monitor volume down"
msgstr "Уменьшить громкость монитора"

msgid "Mute/unmute the monitor audio"
msgstr "Выкл./вкл. звук монитора"
