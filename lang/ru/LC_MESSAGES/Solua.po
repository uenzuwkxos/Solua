msgstr "Сб"

msgid "Sun"
msgstr "Вс"

msgid "About"
msgstr "О программе"

msgid "Privacy policy"
msgstr "Политика конфиденциальности"

msgid "Solua does not collect, store or send any personal data. It has no accounts, no analytics and makes no network connections. Your settings stay in a local file on this computer, and the only communication is between the app and your monitors through the standard DDC/CI protocol."
msgstr "Solua не собирает, не хранит и не отправляет никаких личных данных. Здесь нет учётных записей и аналитики, приложение не устанавливает сетевых соединений. Ваши настройки хранятся в локальном файле на этом компьютере, а единственный обмен данными происходит между приложением и вашими мониторами по стандартному протоколу DDC/CI."

msgid "Open source licenses"
msgstr "Лицензии открытого ПО"

msgid "Close"
msgstr "Закрыть"

msgid "All monitors"
msgstr "Все мониторы"

msgid "No profiles yet."
msgstr "Профилей пока нет."

msgid "A saved profile is active. Switch to “Free” to adjust settings."
msgstr "Активен сохранённый профиль. Переключитесь на «Свободно», чтобы менять настройки."

msgid "Allow modifying saved profiles"
msgstr "Разрешить изменение сохранённых профилей"

msgid "BACKUP"
msgstr "РЕЗЕРВНАЯ КОПИЯ"

