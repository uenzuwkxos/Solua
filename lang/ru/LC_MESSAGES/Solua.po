msgstr "ПОЛЗУНКИ И СОЧЕТАНИЯ КЛАВИШ"

msgid "Save all your settings, profiles, schedule and shortcuts to a file, or load them from one."
msgstr "Сохраните все настройки, профили, расписание и сочетания клавиш в файл или загрузите их из файла."

msgid "Sliders move in fixed steps, marked with dots. Applies to the window and the mini panel."
msgstr "Ползунки двигаются фиксированными шагами, отмеченными точками. Действует для окна и мини-панели."

msgid "Step (sliders and shortcuts)"
msgstr "Шаг (ползунки и сочетания клавиш)"

msgid "Stepped sliders"
msgstr "Ползунки с шагом"

msgid "Top"
msgstr "Сверху"

msgid "Top left"
msgstr "Сверху слева"

msgid "Top right"
msgstr "Сверху справа"

msgid "Up"
msgstr "Вверх"

msgid "While a profile is active, every change you make is saved into it automatically."
msgstr "Пока профиль активен, каждое ваше изменение автоматически сохраняется в нём."

msgid "Yellow"
msgstr "Жёлтый"

msgid "Yellowscale"
msgstr "Оттенки жёлтого"

msgid "Temperature down"
msgstr "Уменьшить температуру"

msgid "Temperature up"
msgstr "Увеличить температуру"

msgid "Black level (blacks)"
msgstr "Уровень чёрного (тени)"

msgid "Display controller"
msgstr "Контроллер дисплея"

msgid "Firmware version"
msgstr "Версия прошивки"

msgid "Gain (whites)"
msgstr "Усиление (светлые тона)"

msgid "Horizontal frequency"
msgstr "Горизонтальная частота"

msgid "IMAGE"
msgstr "ИЗОБРАЖЕНИЕ"

msgid "MONITOR AUDIO"
msgstr "ЗВУК МОНИТОРА"

msgid "MONITOR INFORMATION"
msgstr "СВЕДЕНИЯ О МОНИТОРЕ"

msgid "Monitor volume"
msgstr "Громкость монитора"

msgid "Mute the monitor audio"
msgstr "Отключить звук монитора"

msgid "Not reported"
msgstr "Не сообщается"

msgid "Panel technology"
msgstr "Технология матрицы"

msgid "Restore factory defaults"
msgstr "Восстановить заводские настройки"

msgid "Scales each color channel. It mostly affects the bright areas of the image."
msgstr "Масштабирует каждый цветовой канал. В основном влияет на светлые области изображения."

msgid "Sets the level of the darkest areas of each color channel. It mostly affects the shadows, not the whites."
msgstr "Задаёт уровень самых тёмных областей каждого цветового канала. В основном влияет на тени, а не на белый цвет."

msgid "Show in the mini panel"
msgstr "Показывать в мини-панели"

msgid "This is the audio of the monitor itself (its speakers or headphone jack), for monitors that have it. It is not the system volume."
msgstr "Это звук самого монитора (его динамики или разъём для наушников) для мониторов, которые им оснащены. Это не системная громкость."

msgid "VCP version"
msgstr "Версия VCP"

msgid "Vertical frequency (refresh rate)"
msgstr "Вертикальная частота (частота обновления)"

msgid "Color filter"
msgstr "Цветной фильтр"

msgid "Software filter applied to the whole system."
msgstr "Программный фильтр для всей системы."

msgid "Monitor volume up"
msgstr "Увеличить громкость монитора"

msgid "Monitor volume down"
msgstr "Уменьшить громкость монитора"

msgid "Mute/unmute the monitor audio"
msgstr "Выкл./вкл. звук монитора"

msgid "Input"
msgstr "Вход"

msgid "Shortcuts are assigned by your desktop. You can change them in System Settings → Shortcuts."
msgstr "Сочетания клавиш назначает ваша среда рабочего стола. Изменить их можно в Параметрах системы → Горячие клавиши."

msgid "Sliders move in fixed steps, marked with dots."
msgstr "Ползунки двигаются фиксированными шагами, отмеченными точками."

msgid "Adjust all together"
msgstr "Настраивать все вместе"

msgid "Changes in Controls and Color are applied to every monitor."
msgstr "Изменения на вкладках «Управление» и «Цвет» применяются ко всем мониторам."

msgid "Violet"
msgstr "Фиолетовая"

msgid "Set an end time"
msgstr "Задать время окончания"

msgid "When it ends, the previous profile is restored."
msgstr "По окончании восстанавливается предыдущий профиль."

msgid "Transparency"
msgstr "Прозрачность"

msgid "Run in the background"
msgstr "Работать в фоновом режиме"

msgid "Default"
msgstr "По умолчанию"

msgid "A DDC/CI monitor controller built with Rust and Slint. Extremely light and fast."
msgstr "Управление мониторами по DDC/CI, созданное на Rust и Slint. Очень лёгкое и быстрое."

msgid "Add to the applications menu"
msgstr "Добавить в меню приложений"

msgid "Could not enable monitor access."
msgstr "Не удалось включить доступ к мониторам."

msgid "Creates a launcher for this AppImage."
msgstr "Создаёт ярлык запуска для этого AppImage."

msgid "Enable monitor access"
msgstr "Включить доступ к мониторам"

msgid "Keeps Solua running when the window is closed, so shortcuts keep working."
msgstr "Оставляет Solua работающим при закрытии окна, чтобы сочетания клавиш продолжали работать."

msgid "Monitor access enabled."
msgstr "Доступ к мониторам включён."

msgid "Solua cannot reach your monitors yet. Enabling access sets up a small system rule and asks for your password."
msgstr "Solua пока не имеет доступа к вашим мониторам. Включение доступа создаёт небольшое системное правило и запрашивает пароль."

msgid "Start with the system"
msgstr "Запускать вместе с системой"

msgid "Starts Solua hidden when you log in."
msgstr "Запускает Solua скрытым при входе в систему."

msgid "12-hour clock (AM/PM)"
msgstr "12-часовой формат (AM/PM)"
