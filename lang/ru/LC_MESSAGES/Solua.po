msgstr "Снизу слева"

msgid "Bottom right"
msgstr "Снизу справа"

msgid "Center"
msgstr "По центру"

msgid "Configure everything freely. Saved profiles lock the settings."
msgstr "Настраивайте всё свободно. Сохранённые профили блокируют настройки."

msgid "Could not save the backup: %1"
msgstr "Не удалось сохранить резервную копию: %1"

msgid "Default shortcuts restored"
msgstr "Сочетания клавиш по умолчанию восстановлены"

msgid "Delete"
msgstr "Удалить"

