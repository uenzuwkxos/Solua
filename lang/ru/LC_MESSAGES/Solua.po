msgid "Indicator position"
msgstr "Положение индикатора"

msgid "Indicator size"
msgstr "Размер индикатора"

msgid "Left"
msgstr "Слева"

msgid "No scheduled changes."
msgstr "Нет запланированных изменений."

msgid "Restore defaults"
msgstr "Восстановить значения по умолчанию"

msgid "Right"
msgstr "Справа"

