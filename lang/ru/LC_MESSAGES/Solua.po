msgid "Temperature"
msgstr "Температура"

msgid "CONFIGURE RGB (HARDWARE)"
msgstr "НАСТРОЙКА RGB (АППАРАТНАЯ)"

msgid "SCHEDULED CHANGE"
msgstr "ЗАПЛАНИРОВАННОЕ ИЗМЕНЕНИЕ"

