msgstr "الاختصار غير متاح (هل هو مستخدم بالفعل؟): %1"

msgid "Invalid time. Use HH:MM (e.g. 22:30)"
msgstr "وقت غير صالح. استخدم HH:MM (مثل 22:30)"

msgid "Create a profile first"
msgstr "أنشئ ملفًا شخصيًا أولاً"

msgid "Give the profile a name"
msgstr "أعطِ الملف الشخصي اسمًا"

msgid "This monitor did not report its capabilities"
msgstr "لم تُبلغ هذه الشاشة عن إمكاناتها"

msgid "Demo mode: simulated monitors, nothing is sent to hardware"
msgstr "وضع تجريبي: شاشات محاكاة، ولا يُرسل شيء إلى الأجهزة"

