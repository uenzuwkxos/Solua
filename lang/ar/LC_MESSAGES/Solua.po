msgstr "الشاشات"

msgid "DEMO MODE"
msgstr "الوضع التجريبي"

msgid "Settings"
msgstr "الإعدادات"

msgid "Controls"
msgstr "عناصر التحكم"

msgid "Color"
msgstr "اللون"

msgid "Schedule"
msgstr "الجدولة"

msgid "Advanced"
msgstr "متقدم"

msgid "Not supported"
msgstr "غير مدعوم"

msgid "Control all monitors together"
msgstr "التحكم في جميع الشاشات معًا"

msgid "COLOR TEMPERATURE"
msgstr "درجة حرارة اللون"

msgid "Click again to confirm"
msgstr "انقر مرة أخرى للتأكيد"

msgid "INPUT SOURCE"
msgstr "مصدر الإدخال"

msgid "If you switch to an input without signal, the screen will go blank. Use the monitor's own buttons to return."
msgstr "إذا بدّلت إلى إدخال بلا إشارة فستصبح الشاشة سوداء. استخدم أزرار الشاشة نفسها للعودة."

msgid "SAVE CURRENT SETTINGS AS A PROFILE"
msgstr "حفظ الإعدادات الحالية كملف شخصي"

msgid "Profile name (e.g. Night, Cinema, Work)"
msgstr "اسم الملف الشخصي (مثل ليل، سينما، عمل)"

msgid "Save"
msgstr "حفظ"

msgid "No profiles yet. Adjust your monitors and save the first one above."
msgstr "لا توجد ملفات شخصية بعد. اضبط شاشاتك واحفظ الأول أعلاه."

msgid "Add"
msgstr "إضافة"

msgid "Apply the most recent entry at startup"
msgstr "تطبيق أحدث إدخال عند بدء التشغيل"

msgid "Useful if the computer was off at the scheduled time."
msgstr "مفيد إذا كان الحاسوب مغلقًا في الوقت المجدول."

msgid "WRITE A VCP CODE"
msgstr "كتابة رمز VCP"

msgid "Code (hex)"
msgstr "الرمز (ست عشري)"

msgid "Value"
msgstr "القيمة"

msgid "Write"
msgstr "كتابة"

msgid "CAPABILITIES (VCP)"
msgstr "الإمكانات (VCP)"

msgid "Read all values"
msgstr "قراءة جميع القيم"

msgid "No capability data. Press “Read all values”."
msgstr "لا توجد بيانات إمكانات. اضغط «قراءة جميع القيم»."

msgid "Code"
msgstr "الرمز"

msgid "Name"
msgstr "الاسم"

msgid "Current"
msgstr "الحالي"

msgid "Max"
msgstr "الأقصى"

msgid "RAW CAPABILITIES STRING"
msgstr "سلسلة الإمكانات الخام"

