msgstr "कुंजियाँ दबाएँ…"

msgid "Not set"
msgstr "सेट नहीं"

msgid "Brightness up"
msgstr "चमक बढ़ाएँ"

msgid "Brightness down"
msgstr "चमक घटाएँ"

msgid "Contrast up"
msgstr "कंट्रास्ट बढ़ाएँ"

msgid "Contrast down"
msgstr "कंट्रास्ट घटाएँ"

msgid "Show / hide Solua"
msgstr "Solua दिखाएँ / छिपाएँ"

msgid "Profile: %1"
msgstr "प्रोफ़ाइल: %1"

msgid "Contrast"
msgstr "कंट्रास्ट"

msgid "Volume"
msgstr "वॉल्यूम"

msgid "Muted"
msgstr "म्यूट"

msgid "System default"
msgstr "सिस्टम डिफ़ॉल्ट"

msgid "System"
msgstr "सिस्टम"

msgid "Light"
msgstr "लाइट"

msgid "Dark"
msgstr "डार्क"

msgid "Built-in display"
msgstr "बिल्ट-इन डिस्प्ले"

msgid "External display"
msgstr "बाहरी डिस्प्ले"

