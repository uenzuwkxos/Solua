msgid "Open Solua"
msgstr "Solua खोलें"

msgid "Quit"
msgstr "बाहर निकलें"

msgid "Profiles"
msgstr "प्रोफ़ाइल"

msgid "Brightness"
msgstr "चमक"

msgid "Solua — monitor control"
msgstr "Solua — मॉनिटर नियंत्रण"

msgid "Ready"
msgstr "तैयार"

msgid "No DDC/CI monitors found"
msgstr "कोई DDC/CI मॉनिटर नहीं मिला"

msgid "Monitors found: %1"
msgstr "मिले मॉनिटर: %1"

msgid "Profile “%1” applied"
msgstr "प्रोफ़ाइल “%1” लागू की गई"

msgid "Profile “%1” saved"
msgstr "प्रोफ़ाइल “%1” सहेजी गई"

msgid "Profile “%1” was updated"
msgstr "प्रोफ़ाइल “%1” अपडेट की गई"

