msgstr "スライダーとショートカット"

msgid "Save all your settings, profiles, schedule and shortcuts to a file, or load them from one."
msgstr "すべての設定、プロファイル、スケジュール、ショートカットをファイルに保存、またはファイルから読み込みます。"

msgid "Sliders move in fixed steps, marked with dots. Applies to the window and the mini panel."
msgstr "スライダーはドットで示された固定のステップで動きます。ウィンドウとミニパネルに適用されます。"

msgid "Step (sliders and shortcuts)"
msgstr "ステップ（スライダーとショートカット）"

msgid "Stepped sliders"
msgstr "ステップ式スライダー"

msgid "Top"
msgstr "上"

msgid "Top left"
msgstr "左上"

msgid "Top right"
msgstr "右上"

msgid "Up"
msgstr "上へ"

msgid "While a profile is active, every change you make is saved into it automatically."
msgstr "プロファイルが有効な間は、行った変更がすべて自動的にプロファイルに保存されます。"

msgid "Yellow"
msgstr "黄"

msgid "Yellowscale"
msgstr "黄スケール"

msgid "Temperature down"
msgstr "色温度を下げる"

msgid "Temperature up"
msgstr "色温度を上げる"

msgid "Black level (blacks)"
msgstr "黒レベル（黒）"

