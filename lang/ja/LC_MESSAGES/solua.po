msgstr "ディスプレイコントローラー"

msgid "Firmware version"
msgstr "ファームウェアのバージョン"

msgid "Gain (whites)"
msgstr "ゲイン（白）"

msgid "Horizontal frequency"
msgstr "水平周波数"

msgid "IMAGE"
msgstr "画像"

